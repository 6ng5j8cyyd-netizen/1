# help / main
# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
${c_bold}steamplay v$VERSION${c_rst} — 在 macOS 上玩 Steam 的 Windows 版遊戲（類 CrossOver 工具）

${c_bold}快速開始（三步驟）：${c_rst}
  steamplay setup            安裝 Wine 引擎與相依套件
  steamplay install-steam    在 Wine 環境中安裝 Windows 版 Steam
  steamplay steam            啟動 Windows 版 Steam，登入後即可下載遊戲

${c_bold}日常使用：${c_rst}
  steamplay ui                    圖形介面控制台（也可雙擊「Steamplay 控制台」App）
  steamplay shortcut [--login]    建立「Windows Steam」App 捷徑（--login 開機自動啟動）
  steamplay shortcut <AppID> [名稱]  為單一遊戲建立 App 捷徑（同樣支援 --login）
  steamplay steam                 啟動 Windows 版 Steam
  steamplay launch <AppID>        直接啟動某款遊戲（AppID 見 steamdb.info）
  steamplay run <exe> [args]      執行任意 Windows 程式
  steamplay kill                  強制關閉所有 Windows 程式

${c_bold}效能與相容性：${c_rst}
  steamplay config show           檢視全域設定（同步機制/AVX/HUD/Retina）
  steamplay config set KEY VALUE  修改設定（如 HUD 1 顯示 FPS）
  steamplay game edit <AppID>     編輯單一遊戲的專屬調校
  steamplay tweak [verb]          套用相容性修正（dxvk/vcrun2022/cjkfonts...）
  steamplay setup --engine gptk   改用 Apple Game Porting Toolkit（DX12 效能最佳）
  steamplay gptk-libs <dmg路徑>   安裝 Apple D3DMetal 函式庫

${c_bold}管理：${c_rst}
  steamplay doctor                系統診斷
  steamplay prefix [info|reset|backup]
  steamplay logs                  查看最新執行記錄
  steamplay version | help
EOF
}

main() {
    ensure_dirs 2>/dev/null || true
    load_config

    # macOS 預設的 zsh 互動模式不把「#」當註解：使用者照文件貼上
    # 「steamplay setup  # 說明文字」時，註解會變成參數混進來，一律丟棄
    local _args=() _a
    for _a in "$@"; do
        [[ "$_a" == \#* ]] && break
        _args+=("$_a")
    done
    set -- ${_args[@]+"${_args[@]}"}

    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        setup)          cmd_setup "$@" ;;
        install-steam)  cmd_install_steam "$@" ;;
        steam)          cmd_steam "$@" ;;
        launch)         cmd_launch "$@" ;;
        run)            cmd_run "$@" ;;
        shortcut)       cmd_shortcut "$@" ;;
        ui)             cmd_ui "$@" ;;
        game)           cmd_game "$@" ;;
        tweak)          cmd_tweak "$@" ;;
        gptk-libs)      cmd_gptk_libs "$@" ;;
        config)         cmd_config "$@" ;;
        prefix)         cmd_prefix "$@" ;;
        kill)           cmd_kill "$@" ;;
        logs)           cmd_logs "$@" ;;
        doctor)         cmd_doctor "$@" ;;
        version|-v|--version) echo "steamplay v$VERSION" ;;
        help|-h|--help|*) usage ;;
    esac
}

main "$@"
